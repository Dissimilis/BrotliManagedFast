<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The only other managed Brotli codec: a 1:1 port of reference v0.6.0, frozen since 2021. -->
    <PackageReference Include="BrotliSharpLib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrotliManagedFast\BrotliManagedFast.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Corpus: reference texts and a map tile from the google/brotli test data, plus generated JSON. -->
    <None Include="..\BrotliManagedFast.Tests\TestData\alice29.txt" Link="Data\alice29.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\lcet10.txt" Link="Data\lcet10.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\plrabn12.txt" Link="Data\plrabn12.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\mapsdatazrh" Link="Data\mapsdatazrh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\x.compressed" Link="Data\x.compressed" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\x" Link="Data\x" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrotliManagedFast.Tests\TestData\alice29.txt.compressed" Link="Data\alice29.txt.compressed" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
